#!/usr/bin/env bash
#
# pre-commit — 对 staged 内容执行快速、确定性的 Gate 与 Check。
# 输入:Git index。输出:带规则 ID 的诊断。
# 失败语义:Gate 失败时非零；Check 只报告。本地可 --no-verify，CI 不受影响。
# 规则:GATE-LARGE-FILES、GATE-ROOT-ALLOWLIST、CHECK-BRANCH-NAME、
# CHECK-CHANGE-TIER、CHECK-SWIFT-FORMAT（完整 Gate 集合由 repo-doctor/CI 覆盖）。
#
set -uo pipefail

MAX_SIZE=$((5 * 1024 * 1024))

# core.quotepath=false:git 默认会把中文等非 ASCII 文件名转义成 "\351..." 的带引号形式,
# 那样下面所有按文件名匹配的检查都会失效(实测:中文名的大文件能因此绕过拦截)
staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# 1) 大文件拦截。注意量的是"暂存区里的内容"而不是磁盘上的文件——
#    两者可能不一致(先 add 大文件、再缩小磁盘上的副本,就能骗过按磁盘文件测量的检查)
while IFS= read -r f; do
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_SIZE" ]; then
        echo "❌ GATE-LARGE-FILES:$f 暂存内容为 $((size / 1024 / 1024))MB(>5 MiB)" >&2
        fail=1
    fi
done <<< "$staged"

# 1b) 根目录 openspec/ 拦截。openspec new 在没有工作区的目录会静默新建一个,
#     根目录一旦出现 openspec/ 就会抢走命令的定位,变更文档从此写错地方——必须拒之门外
root_openspec=$(echo "$staged" | grep '^openspec/' || true)
if [ -n "$root_openspec" ]; then
    {
        echo "❌ GATE-ROOT-ALLOWLIST:仓库根目录不创建 openspec store。变更请建到对应目录:"
        echo "    (cd Apps/<App> && mise exec -- openspec new change <name>)"
        echo "    误建的根目录 openspec/ 直接删除即可"
    } >&2
    fail=1
fi

# 2) 共享层分支提醒。Modules/ 的改动影响所有 app,约定在 change/modules-* 分支上做,
#    这里只提醒不拦截(比如版本升级这类跨领域改动会正当地触碰它)
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)
modules_touched=$(echo "$staged" | grep '^Modules/' || true)
if [ -n "$modules_touched" ] && [[ "$branch" != change/modules-* ]]; then
    {
        echo "⚠️  CHECK-BRANCH-NAME:分支 $branch 的 scope 可能与 Modules/ 改动不匹配:"
        echo "$modules_touched" | sed 's/^/    /'
    } >&2
fi

# 3) 混合提交提醒。一次提交同时动 app 和共享区,回退时会互相牵连,建议拆开
shared_touched=$(echo "$staged" | grep -E '^(Modules/|Tuist/|Workspace\.swift|scripts/|\.githooks/|\.claude/|CLAUDE\.md)' || true)
apps_touched=$(echo "$staged" | grep '^Apps/' || true)
if [ -n "$apps_touched" ] && [ -n "$shared_touched" ]; then
    echo "⚠️  CHECK-CHANGE-TIER:同一提交包含 App 与共享区，请复核变更等级和验证范围" >&2
fi

# 4) Swift 格式检查(逐个文件调用,文件名带空格也安全;只提醒不拦截)
swift_staged=$(echo "$staged" | grep '\.swift$' || true)
if [ -n "$swift_staged" ]; then
    if xcrun --find swift-format >/dev/null 2>&1; then
        while IFS= read -r f; do
            xcrun swift-format lint "$f" 2>&1 || true
        done <<< "$swift_staged" | head -20
    else
        echo "ℹ️  pre-commit:未找到 swift-format(随 Xcode 工具链提供),本次跳过格式检查" >&2
    fi
fi

exit "$fail"
