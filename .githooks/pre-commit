#!/usr/bin/env bash
# pre-commit — 对 staged 内容运行共享 Gate，并报告快速 Checks。
# 输入:Git index。输出:与 repo-doctor --staged 一致的 Gate ID，加分支/格式报告。
# 失败语义:Gate 失败时非零；Check 不改变退出码；--no-verify 只影响本地。
# 规则:GATE-ROOT-ALLOWLIST、GATE-GENERATED-FILES、GATE-SECRETS、
# GATE-LARGE-FILES、GATE-DEPENDENCY-SOURCE、CHECK-BRANCH-NAME、
# CHECK-CHANGE-TIER、CHECK-SWIFT-FORMAT。
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
    echo "❌ pre-commit:无法定位仓库根" >&2
    exit 1
fi
cd "$REPO_ROOT"

staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

if ! scripts/repo-doctor.sh --staged; then
    exit 1
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)
if ! scripts/validate-branch-name.sh "$branch"; then
    echo "⚠️  CHECK-BRANCH-NAME:$branch 不符合已声明的 change/<scope>-<verb-object>" >&2
fi

if [ "$branch" != "${branch#change/repo-}" ]; then
    : # repo scope 可合法跨 App/Modules/工具边界。
else
    modules_touched=$(printf '%s\n' "$staged" | grep '^Modules/' || true)
    apps_touched=$(printf '%s\n' "$staged" | grep '^Apps/' || true)
    if [ -n "$modules_touched" ] && [ "$branch" = "${branch#change/modules-}" ]; then
        echo "⚠️  CHECK-BRANCH-NAME:$branch 的 scope 可能与 Modules/ 改动不匹配" >&2
    fi
    if [ -n "$modules_touched" ] && [ -n "$apps_touched" ]; then
        echo "⚠️  CHECK-CHANGE-TIER:同一提交触及 App 与共享层，请复核是否应升级 full-change/repo-change" >&2
    fi
fi

swift_staged=$(printf '%s\n' "$staged" | grep '\.swift$' || true)
if [ -n "$swift_staged" ]; then
    if command -v xcrun >/dev/null 2>&1 && xcrun --find swift-format >/dev/null 2>&1; then
        format_output=""
        while IFS= read -r file; do
            [ -f "$file" ] || continue
            current_output=$(xcrun swift-format lint "$file" 2>&1 || true)
            [ -z "$current_output" ] || format_output="$format_output
$current_output"
        done <<EOF
$swift_staged
EOF
        if [ -n "$format_output" ]; then
            echo "⚠️  CHECK-SWIFT-FORMAT:staged Swift 存在格式报告" >&2
            printf '%s\n' "$format_output" | sed '/^$/d' | head -20 >&2
        fi
    else
        echo "⚠️  CHECK-SWIFT-FORMAT:当前环境没有 swift-format，跳过报告" >&2
    fi
fi

exit 0
